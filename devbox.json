{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.27",
    "git@latest",
    "gopls@latest",
    "gh@latest",
    "golangci-lint@latest",
    "gofumpt@latest",
    "svu@latest",
    "jujutsu@latest",
    "go-task@latest",
    "goreleaser@latest"
  ],
  "shell": {
